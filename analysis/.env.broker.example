# BIAP broker integration template — SERVER ONLY
# Copy values into the VPS/systemd environment after Farabi provides official docs.
# Never put these values in Expo/mobile .env files and never commit real secrets.

BIAP_BROKER_PROVIDER=farabi
BIAP_BROKER_ENV=sandbox
BIAP_BROKER_BASE_URL=
BIAP_BROKER_CLIENT_ID=
BIAP_BROKER_CLIENT_SECRET=
BIAP_BROKER_API_KEY=
BIAP_BROKER_ACCOUNT_ID=
BIAP_BROKER_CALLBACK_URL=https://biap.dadashi.no/api/broker/callback
BIAP_BROKER_FUNDING_URL=

# Fill these with the exact documented paths from Farabi.
BIAP_BROKER_TOKEN_PATH=
BIAP_BROKER_BUYING_POWER_PATH=
BIAP_BROKER_PORTFOLIO_PATH=
BIAP_BROKER_ORDERS_PATH=
BIAP_BROKER_ORDER_STATUS_PATH=
BIAP_BROKER_CANCEL_ORDER_PATH=

# Safety lock. Keep false through development and sandbox wiring.
# Production requires an explicit separate enable step after UAT/compliance checks.
LIVE_TRADING_ENABLED=false
