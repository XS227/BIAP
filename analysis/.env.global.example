# BIAP Global runtime configuration
# Copy to a server-only environment file; never commit real credentials.
# Strict MIC universe routing deployed: 2026-09-23.
# Universe cache schema v11 deployed: 2026-09-24.
# Authoritative-universe ranking gate deployed: 2026-09-23.
# Post-refresh authoritative catalog metadata fix deployed: 2026-09-24.
# Official domestic universes: DE/XETRA, DE/FRANKFURT, AU/ASX.
# FIRDS authoritative universes: FR/Paris, IT/Milan, NL/Amsterdam, BE/Brussels, PT/Lisbon, NO/Oslo, ES/Madrid.
# Official Euronext regulated ISIN→Symbol + exchange-wide EOD: FR/IT/NL/BE/PT/NO deployed 2026-09-24.

# Persistent verified-source cache on the Global server
BIAP_GLOBAL_DATA_DIR=/var/lib/biap-global
BIAP_GLOBAL_UNIVERSE_CACHE_HOURS=12
BIAP_GLOBAL_MARKET_CACHE_HOURS=6
BIAP_GLOBAL_FUNDAMENTALS_CACHE_HOURS=24

# Ranking integrity gates. A market is not allowed into "This market" or Global
# Top 10 unless fresh ordinary-equity market coverage and official fundamental
# provenance clear these thresholds.
BIAP_GLOBAL_MIN_MARKET_COVERAGE_PCT=90
BIAP_GLOBAL_MIN_FUNDAMENTAL_COVERAGE_PCT=70

# Comma-separated COUNTRY:EXCHANGE keys may be added only after that market's
# universe source has been independently validated against its official venue list.
BIAP_GLOBAL_AUTHORITATIVE_UNIVERSE_MARKETS=

# Licensed global market/universe/FX provider fallback for non-Euronext markets.
BIAP_GLOBAL_MARKET_BASE=https://api.twelvedata.com
BIAP_GLOBAL_MARKET_API_KEY=

# Preferred additional whole-exchange EOD source for markets without an official
# venue-wide source already integrated. Euronext regulated markets use Euronext
# Live official exchange-wide EOD first.
BIAP_EODHD_API_TOKEN=
BIAP_GLOBAL_DAILY_DEEP_LIMIT=50

# United States — SEC EDGAR/XBRL. Set a real monitored contact identity before use.
# Raw CompanyFacts responses are cached under BIAP_GLOBAL_DATA_DIR/cache/sec-edgar.
BIAP_SEC_USER_AGENT=

# Europe / Norway / UK — ESEF/UKSEF + GLEIF; no API key currently required.
# Verified xBRL responses and normalized filing snapshots are cached server-side.
BIAP_ESEF_INDEX_BASE=https://filings.xbrl.org
BIAP_GLEIF_BASE=https://api.gleif.org/api/v1

# United Kingdom — Companies House live company/filing metadata
BIAP_COMPANIES_HOUSE_API_KEY=
BIAP_COMPANIES_HOUSE_BASE=https://api.company-information.service.gov.uk

# Japan — FSA EDINET API v2
BIAP_EDINET_API_KEY=
BIAP_EDINET_BASE=https://api.edinet-fsa.go.jp/api/v2
BIAP_EDINET_SYNC_DAYS=450

# South Korea — FSS OpenDART
BIAP_OPENDART_API_KEY=
BIAP_OPENDART_BASE=https://engopendart.fss.or.kr/engapi

# Australia — official ASX ISIN directory now provides the domestic ordinary-equity
# universe. Market prices still require the full-market feed; official issuer
# fundamentals can be normalized into the verified filing drop.
BIAP_ASX_FILING_DROP=/var/lib/biap-global/filings/AU

# Global live execution remains disabled until validation + broker authorization.
BIAP_GLOBAL_LIVE_TRADING_ENABLED=false
