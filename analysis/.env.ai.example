# Kiasha AI brain — SERVER ONLY. Never put this key in Expo/mobile code.
ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE=https://api.anthropic.com/v1
ANTHROPIC_VERSION=2023-06-01
KIASHA_AI_MODEL=claude-sonnet-5
KIASHA_AI_TIMEOUT_SECONDS=30
KIASHA_AI_MAX_POSITION_PCT=10

# Server-owned Paper simulation. Keep false until deployment/tests are verified.
KIASHA_PAPER_INITIAL_CASH=100000000
KIASHA_PAPER_MIN_CONFIDENCE=0.55
KIASHA_PAPER_EXECUTION_ENABLED=false

# Keep real broker execution disabled independently of AI/Paper configuration.
LIVE_TRADING_ENABLED=false
