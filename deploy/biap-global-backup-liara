#!/bin/bash
# Weekly: copy the newest backup to Liara (root@89.42.199.20:/root/uniweb-backups/) and keep only the last 2 biap-global-* copies there.
# Checks Liara free space first (needs 2x the backup size + 5 GB) and never touches anything else in uniweb-backups.
set -u
ROOT=${BIAP_BACKUP_ROOT:-/home/ubuntu/backups}
REMOTE=${BIAP_LIARA_HOST:-root@89.42.199.20}
RDIR=${BIAP_LIARA_DIR:-/root/uniweb-backups}
KEY=${BIAP_LIARA_KEY:-}
SSH=(ssh -o BatchMode=yes -o ConnectTimeout=15 -o ServerAliveInterval=30); [ -n "$KEY" ] && SSH+=(-i "$KEY" -o IdentitiesOnly=yes)
log() { echo "$(date -u +%FT%TZ) $*"; }
LATEST=$(ls -1d "$ROOT"/weekly/????-??-?? "$ROOT"/daily/????-??-?? 2>/dev/null | xargs -r -n1 basename | sort | tail -1)
SRC=$(ls -1d "$ROOT"/weekly/"$LATEST" "$ROOT"/daily/"$LATEST" 2>/dev/null | head -1)
[ -n "$SRC" ] || { log "FAIL: no local backup found"; exit 1; }
NEED_KB=$(( $(du -sk -L "$SRC" | cut -f1) * 2 + 5*1024*1024 ))
log "latest backup: $SRC need_free_kb=$NEED_KB"
FREE_KB=$("${SSH[@]}" "$REMOTE" "mkdir -p '$RDIR' && df -Pk '$RDIR' | awk 'NR==2{print \$4}'") || { log "FAIL: cannot reach $REMOTE (ssh)"; exit 1; }
log "Liara free_kb=$FREE_KB"
[[ "$FREE_KB" =~ ^[0-9]+$ ]] && [ "$FREE_KB" -ge "$NEED_KB" ] || { log "FAIL: not enough space on Liara, nothing copied"; exit 1; }
NAME=biap-global-$LATEST
rsync -a --partial --bwlimit=20000 -e "${SSH[*]}" "$SRC"/ "$REMOTE:$RDIR/$NAME.partial/" || { log "FAIL: rsync"; exit 1; }
"${SSH[@]}" "$REMOTE" "cd '$RDIR' && rm -rf '$NAME' && mv '$NAME.partial' '$NAME'" || { log "FAIL: finalize"; exit 1; }
# keep the 2 newest biap-global-YYYY-MM-DD dirs only
"${SSH[@]}" "$REMOTE" "cd '$RDIR' && ls -1d biap-global-????-??-?? 2>/dev/null | sort | head -n -2 | xargs -r rm -rf --" || log "WARN: remote prune failed"
log "Liara now: $("${SSH[@]}" "$REMOTE" "ls -1d '$RDIR'/biap-global-* | tr '\n' ' '; df -h '$RDIR' | tail -1")"
log "LIARA COPY done $NAME"
