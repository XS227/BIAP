[Unit]
Description=BIAP Global persistent analysis queue worker (drains every market ledger)
After=network-online.target biap-global.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/biap-global/BIAP/analysis
Environment=PYTHONPATH=/home/ubuntu/biap-global/BIAP/analysis
Environment=BIAP_GLOBAL_DATA_DIR=/var/lib/biap-global
EnvironmentFile=-/home/ubuntu/biap-global/BIAP/analysis/.env.global
ExecStart=/home/ubuntu/biap-global/BIAP/analysis/.venv-global/bin/python -m global_markets.analysis_worker
TimeoutStartSec=1800
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/var/lib/biap-global /home/ubuntu/biap-global/BIAP/.runtime
