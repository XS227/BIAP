[Unit]
Description=BIAP Kiasha Paper daily equity snapshot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/biap-kiasha/XS227-BIAP/analysis
Environment=PYTHONUNBUFFERED=1
Environment="BIAP_TSETMC_API_BASE=http://89.42.199.20:8090/tsetmc-cdn/api"
ExecStart=/home/ubuntu/biap-kiasha/XS227-BIAP/analysis/.venv/bin/python /home/ubuntu/biap-kiasha/XS227-BIAP/analysis/paper_equity_snapshot.py
Nice=10

[Install]
WantedBy=multi-user.target
